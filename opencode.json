{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy",
        "graphify-mcp"
      ],
      "enabled": true
    },
    "ui-registry": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "ui-registry-mcp@0.7.1"
      ],
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": "uvx",
      "args": [
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": false
    }
  },
  "plugins": [
    "./.opencode/plugins/config-protection.js",
    "./.opencode/plugins/rtk-interceptor.js",
    "./.opencode/plugins/headroom-guard.js",
    "./.opencode/plugins/ponytail-compactor.js",
    "./.opencode/plugins/session-start.js"
  ]
}
