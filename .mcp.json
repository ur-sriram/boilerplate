{
  "mcpServers": {
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "graphify-mcp"
      ],
      "description": "Codebase AST knowledge graph server for structural exploration",
      "disabled": false,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "ui-registry": {
      "command": "npx",
      "args": [
        "-y",
        "ui-registry-mcp@0.7.1"
      ],
      "disabled": true,
      "description": "Component discovery MCP server across 12 shadcn-style registries (ui profile)",
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "headroom": {
      "command": "uvx",
      "args": [
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ],
      "disabled": true,
      "description": "Dynamic context compression engine (compression profile)",
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    }
  }
}
