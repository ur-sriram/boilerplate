{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/run-hook.mjs protect-config"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/run-hook.mjs rtk-filter"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/run-hook.mjs session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/run-hook.mjs memory-sync"
          }
        ]
      }
    ]
  }
}
