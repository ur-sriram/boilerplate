# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and configure local values.
# NEVER commit .env to source control (strictly ignored by .gitignore).
# ZERO secrets are stored in this template.
# ==============================================================================

# Project Runtime Environment
BOILERPLATE_ENV=development

# Active MCP Profile: core | ui | compression | all (default: core)
MCP_PROFILE=core

# Freebuff / Codebuff Automation Bypass
# Bypasses interactive agent directory trust prompt in CI / automated environments.
# Documented as a named exception in THIRD_PARTY.md and docs/agents/freebuff.md
CODEBUFF_TRUST_AGENT_DIRS=1

# Output Compression & Token Killer Interceptor
# Enables scripts/hooks/rtk-filter hook when rtk CLI is installed.
RTK_ENABLED=1

# Headroom Token Compression MCP Server (Optional)
HEADROOM_MAX_TOKENS=4096

# Browser Harness (browser-use) Settings (Optional)
BROWSER_HARNESS_CDP_PORT=9222
BROWSER_HARNESS_HEADLESS=1

# Optional Third-Party Model & Tool API Keys (Dummy placeholders - DO NOT COMMIT REAL KEYS)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
