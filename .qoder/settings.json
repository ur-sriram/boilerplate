{
  "rules": [
    "AGENTS.md",
    ".agents/rules/core-invariants.md"
  ],
  "skills": {
    "directory": ".qoder/skills"
  },
  "mcp": {
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy",
        "graphify-mcp"
      ],
      "enabled": true,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "ui-registry": {
      "command": "npx",
      "args": [
        "-y",
        "ui-registry-mcp@0.7.1"
      ],
      "enabled": false,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "headroom": {
      "command": "uvx",
      "args": [
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": false,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    }
  },
  "hooks": {
    "PreToolUse": "node ./scripts/hooks/run-hook.mjs protect-config",
    "PostToolUse": "node ./scripts/hooks/run-hook.mjs rtk-filter",
    "SessionStart": "node ./scripts/hooks/run-hook.mjs session-start"
  }
}
