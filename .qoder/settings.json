{
  "rules": [
    "AGENTS.md",
    ".agents/rules/core-invariants.md"
  ],
  "skills": {
    "directory": ".qoder/skills"
  },
  "mcp": {
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy",
        "graphify-mcp"
      ],
      "enabled": true
    },
    "ui-registry": {
      "command": "npx",
      "args": [
        "-y",
        "ui-registry-mcp@0.7.1"
      ],
      "enabled": false
    },
    "headroom": {
      "command": "uvx",
      "args": [
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": false
    }
  },
  "hooks": {
    "PreToolUse": "node ./scripts/hooks/run-hook.mjs protect-config",
    "PostToolUse": "node ./scripts/hooks/run-hook.mjs rtk-filter",
    "SessionStart": "node ./scripts/hooks/run-hook.mjs session-start"
  }
}
