{
  "$schema": "https://json.schemastore.org/mcp-settings.json",
  "mcpServers": {
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "graphify-mcp"
      ],
      "profile": "core",
      "enabled": true,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "ui-registry": {
      "command": "npx",
      "args": [
        "-y",
        "ui-registry-mcp@0.7.1"
      ],
      "profile": "ui",
      "enabled": false,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    },
    "headroom": {
      "command": "uvx",
      "args": [
        "--from",
        "headroom-ai[mcp]",
        "headroom",
        "mcp",
        "serve"
      ],
      "profile": "compression",
      "enabled": false,
      "env": {
        "UV_CACHE_DIR": ".cache/uv",
        "UV_DATA_DIR": ".cache/uv-data",
        "UV_TOOL_DIR": ".cache/uv-tools",
        "XDG_CACHE_HOME": ".cache",
        "XDG_DATA_HOME": ".cache/xdg-data",
        "npm_config_cache": ".cache/npm"
      }
    }
  }
}
